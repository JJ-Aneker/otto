# Copia este fichero a .env y rellena los valores. NUNCA subas .env a GitHub.
SUPABASE_URL=https://xxxx.supabase.co
# Clave 'Publishable' (sb_publishable_...) — o 'anon' si usas las claves antiguas
SUPABASE_ANON_KEY=sb_publishable_...
# Clave 'Secret' (sb_secret_...) — o 'service_role' si usas las antiguas. Solo servidor, nunca en el navegador ni en el chat
SUPABASE_SERVICE_KEY=sb_secret_...
# Clave maestra de cifrado (32 bytes en base64). Genera una con: npm run gen-key  
MASTER_KEY=
